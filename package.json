{
  "name": "trading-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Automated EMA crossover trading bot for Kraken (BTC/EUR, ETH/EUR)",
  "main": "dist/handler.js",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node20 --outfile=dist/handler.js --external:@aws-sdk/*",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "synth": "cd infra && npx cdk synth",
    "deploy": "npm run build && cd infra && npx cdk deploy --require-approval never",
    "backtest": "npx tsx backtester/index.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/client-sns": "^3.600.0",
    "@aws-sdk/client-secrets-manager": "^3.600.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "aws-cdk-lib": "^2.150.0",
    "aws-cdk": "^2.150.0",
    "constructs": "^10.3.0",
    "esbuild": "^0.23.0",
    "fast-check": "^3.19.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
